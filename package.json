{
  "name": "facebook-marketplace-mcp",
  "version": "1.0.0",
  "description": "MCP server for Facebook Marketplace \u2014 direct GraphQL API access",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "facebook-marketplace-mcp": "dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc && node scripts/copy-tracker-assets.mjs",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "capture-queries": "tsx scripts/capture-queries.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "tracker": "node dist/tracker/cli.js serve",
    "tracker:scan": "node dist/tracker/cli.js scan",
    "tracker:report": "node dist/tracker/cli.js report",
    "tracker:import": "node dist/tracker/cli.js import-baseline",
    "tracker:install-ui": "node scripts/install-tracker-agent.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3": "^13.0.3",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "playwright": "^1.63.0"
  }
}
